+
+func accountAllowsModelPredicate(modelCode string) func(*model.Account) bool {
+	return func(acc *model.Account) bool {
+		return accountAllowsModel(acc, modelCode)
+	}
+}
+
+func accountAllowsModel(acc *model.Account, modelCode string) bool {
+	if acc == nil {
+		return false
+	}
+	if acc.ModelWhitelist == nil || strings.TrimSpace(*acc.ModelWhitelist) == "" {
+		return true
+	}
+	var raw []string
+	if err := json.Unmarshal([]byte(*acc.ModelWhitelist), &raw); err != nil {
+		return true
+	}
+	modelCode = strings.TrimSpace(modelCode)
+	if modelCode == "" {
+		return true
+	}
+	for _, item := range raw {
+		pattern := strings.TrimSpace(item)
+		if pattern == "" {
+			continue
+		}
+		if pattern == "*" || strings.EqualFold(pattern, modelCode) {
+			return true
+		}
+		if strings.HasSuffix(pattern, "*") {
+			prefix := strings.TrimSuffix(pattern, "*")
+			if prefix != "" && strings.HasPrefix(strings.ToLower(modelCode), strings.ToLower(prefix)) {
+				return true
+			}
+		}
+	}
+	return false
+}
