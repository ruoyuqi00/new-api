 func TestProviderCooldownRetryable429StillCooldowns(t *testing.T) {
 	err := errors.New(`provider call: grok video HTTP 429: {"error":{"code":8,"message":"Too many requests"}}`)
 	got := providerCooldown(err)
 	if got < 30*time.Minute {
 		t.Fatalf("expected 429 cooldown >= 30m, got %s", got)
 	}
 }
+
+func TestAccountAllowsModelWhitelist(t *testing.T) {
+	empty := &model.Account{}
+	if !accountAllowsModel(empty, "gpt-image-2") {
+		t.Fatal("expected empty whitelist to allow the model")
+	}
+
+	exact := `["gpt-image-2"]`
+	if !accountAllowsModel(&model.Account{ModelWhitelist: &exact}, "gpt-image-2") {
+		t.Fatal("expected exact whitelist match")
+	}
+	if accountAllowsModel(&model.Account{ModelWhitelist: &exact}, "grok-imagine-video") {
+		t.Fatal("expected non-matching model to be rejected")
+	}
+
+	prefix := `["veo_3_1_*"]`
+	if !accountAllowsModel(&model.Account{ModelWhitelist: &prefix}, "veo_3_1_t2v_fast_landscape") {
+		t.Fatal("expected prefix wildcard whitelist match")
+	}
+	if accountAllowsModel(&model.Account{ModelWhitelist: &prefix}, "gemini-3.1-flash-image-square") {
+		t.Fatal("expected unrelated model to be rejected")
+	}
+}
+
+func TestAccountAllowsModelInvalidWhitelistFailsOpen(t *testing.T) {
