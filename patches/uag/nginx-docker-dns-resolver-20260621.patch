diff --git a/deploy/nginx/user.conf b/deploy/nginx/user.conf
--- a/deploy/nginx/user.conf
+++ b/deploy/nginx/user.conf
@@
-upstream klein_api {
-    server api:17180;
-    keepalive 32;
-}
-
-upstream klein_user_web {
-    server user-web:80;
-    keepalive 16;
-}
