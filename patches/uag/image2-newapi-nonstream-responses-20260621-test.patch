+func TestParseCompletedJSONResponse(t *testing.T) {
+	raw := `{"output":[{"type":"image_generation_call","result":"ZmFrZS1iNjQ=","output_format":"png","size":"1024x1024","quality":"high"}]}`
+	completed, err := parseCompletedJSONResponse(strings.NewReader(raw))
+	if err != nil {
+		t.Fatalf("parseCompletedJSONResponse error: %v", err)
+	}
+	if completed == nil || len(completed.Response.Output) != 1 {
+		t.Fatalf("expected one output item, got %#v", completed)
+	}
+	data, imageURL := outputImagePayload(completed.Response.Output[0])
+	if data != "ZmFrZS1iNjQ=" || imageURL != "" {
+		t.Fatalf("unexpected image payload data=%q url=%q", data, imageURL)
+	}
