+func absolutizeCachedRefs(refs []string) []string {
+	out := make([]string, 0, len(refs))
+	for _, ref := range refs {
+		out = append(out, absolutizeCachedRef(ref))
+	}
+	return out
+}
+
+func absolutizeCachedRef(ref string) string {
+	ref = strings.TrimSpace(ref)
+	if !strings.HasPrefix(ref, "/api/v1/gen/cached/") {
+		return ref
+	}
+	base := strings.TrimRight(strings.TrimSpace(os.Getenv("KLEIN_PUBLIC_OPENAI_BASE_URL")), "/")
+	if base == "" {
+		base = strings.TrimRight(strings.TrimSpace(os.Getenv("KLEIN_PUBLIC_API_BASE_URL")), "/")
+	}
+	if base == "" {
+		base = "https://image-api.vyywcw.cn"
+	}
+	return base + ref
+}
