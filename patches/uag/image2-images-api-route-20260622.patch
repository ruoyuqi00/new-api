+func TestGenerateImage2ImagesAPIRouteUsesEditsEndpointForReferences(t *testing.T) {
+	var gotPath string
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotPath = r.URL.Path
+		var body imgReq
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Fatalf("decode request: %v", err)
+		}
+		if body.Image != "https://example.com/in.png" {
+			t.Fatalf("image = %q, want reference URL", body.Image)
+		}
+		_, _ = w.Write([]byte(`{"created":1,"data":[{"b64_json":"ZmFrZS1pbWFnZQ=="}]}`))
+	}))
+	defer srv.Close()
+
+	out, err := New("").Generate(context.Background(), &provider.Request{
+		Kind:       provider.KindImage,
+		Mode:       provider.ModeI2I,
+		ModelCode:  "gpt-image-2",
+		Prompt:     "change background",
+		Count:      1,
+		BaseURL:    srv.URL,
+		Credential: "test-key",
+		RefAssets:  []string{"https://example.com/in.png"},
+		Params:     map[string]any{"route": "images"},
+	})
+	if err != nil {
+		t.Fatalf("Generate error: %v", err)
+	}
+	if gotPath != "/v1/images/edits" {
+		t.Fatalf("path = %q, want /v1/images/edits", gotPath)
+	}
+	if out == nil || len(out.Assets) != 1 || !strings.HasPrefix(out.Assets[0].URL, "data:image/png;base64,") {
+		t.Fatalf("unexpected result: %#v", out)
+	}
+}
