+func TestGenerateImage2ImagesAPIRouteUsesGenerationsEndpoint(t *testing.T) {
+	var gotPath string
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotPath = r.URL.Path
+		var body imgReq
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Fatalf("decode request: %v", err)
+		}
+		if body.Model != "gpt-image-2" || body.Prompt != "draw a cat" || body.N != 1 {
+			t.Fatalf("unexpected request body: %#v", body)
+		}
+		if body.Image != "" || len(body.Images) != 0 {
+			t.Fatalf("generation request should not include edit images: %#v", body)
+		}
+		_, _ = w.Write([]byte(`{"created":1,"data":[{"url":"https://example.com/out.png"}]}`))
+	}))
+	defer srv.Close()
+
+	out, err := New("").Generate(context.Background(), &provider.Request{
+		Kind:       provider.KindImage,
+		Mode:       provider.ModeT2I,
+		ModelCode:  "gpt-image-2",
+		Prompt:     "draw a cat",
+		Count:      1,
+		BaseURL:    srv.URL,
+		Credential: "test-key",
+		Params:     map[string]any{"route": "images"},
+	})
+	if err != nil {
+		t.Fatalf("Generate error: %v", err)
+	}
+	if gotPath != "/v1/images/generations" {
+		t.Fatalf("path = %q, want /v1/images/generations", gotPath)
+	}
+	if out == nil || len(out.Assets) != 1 || out.Assets[0].URL == "" {
+		t.Fatalf("unexpected result: %#v", out)
+	}
+}
