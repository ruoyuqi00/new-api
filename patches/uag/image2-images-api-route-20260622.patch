+func wantsImagesAPIRoute(req *provider.Request) bool {
+	if req == nil {
+		return false
+	}
+	route := strings.ToLower(strings.TrimSpace(strParam(req.Params, "route", strParam(req.Params, "provider_route", ""))))
+	return route == "images" || route == "image" || route == "images_api" || route == "openai_images" || route == "newapi_images"
+}
+
+func isImagesAPIEditRequest(req *provider.Request) bool {
+	if req == nil {
+		return false
+	}
+	return req.Mode == provider.ModeI2I ||
+		len(compactRefs(req.RefAssets)) > 0 ||
+		strings.EqualFold(strParam(req.Params, "operation", ""), "edit")
+}
+
+func compactRefs(refs []string) []string {
+	out := make([]string, 0, len(refs))
+	for _, ref := range refs {
+		ref = strings.TrimSpace(ref)
+		if ref != "" {
+			out = append(out, ref)
+		}
+	}
+	return out
+}
+
 func isGPTImage2(model string) bool {
 	return imageToolModel(model) == "gpt-image-2"
 }
