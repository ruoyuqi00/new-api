+func TestGrokImagesAPIRoute(t *testing.T) {
+	var gotPath string
+	var gotBody map[string]any
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotPath = r.URL.Path
+		if r.Header.Get("Authorization") != "Bearer test-key" {
+			t.Fatalf("Authorization = %q", r.Header.Get("Authorization"))
+		}
+		if err := json.NewDecoder(r.Body).Decode(&gotBody); err != nil {
+			t.Fatalf("decode request: %v", err)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"data":[{"url":"https://cdn.example/image.png"}]}`))
+	}))
+	defer server.Close()
+
+	p := New(server.URL)
+	out, err := p.Generate(context.Background(), &provider.Request{
+		TaskID:     "task-image",
+		Kind:       provider.KindImage,
+		ModelCode:  "grok-imagine-image",
+		Prompt:     "draw a quiet lake",
+		Count:      1,
+		Credential: "test-key",
+		BaseURL:    server.URL,
+	})
+	if err != nil {
+		t.Fatalf("Generate() error = %v", err)
+	}
+	if gotPath != "/v1/images/generations" {
+		t.Fatalf("path = %q, want /v1/images/generations", gotPath)
+	}
+	if gotBody["model"] != "grok-imagine-image" || gotBody["prompt"] != "draw a quiet lake" {
+		t.Fatalf("body = %#v", gotBody)
+	}
+	if len(out.Assets) != 1 || out.Assets[0].URL != "https://cdn.example/image.png" {
+		t.Fatalf("assets = %#v", out.Assets)
+	}
+}
