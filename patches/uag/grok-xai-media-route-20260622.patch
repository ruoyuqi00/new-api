+func (p *Provider) generateImageAPI(ctx context.Context, req *provider.Request) (*provider.Result, error) {
+	base := apiBaseURL(req.BaseURL)
+	count := req.Count
+	if count <= 0 {
+		count = 1
+	}
+	if count > 4 {
+		count = 4
+	}
+	refs := compactRefs(req.RefAssets)
+	edit := len(refs) > 0 || strings.EqualFold(strParam(req.Params, "operation", ""), "edit")
+	if edit && len(refs) == 0 {
+		return nil, fmt.Errorf("grok image edit requires at least one image")
+	}
+	url := base + "/v1/images/generations"
+	if edit {
+		url = base + "/v1/images/edits"
+	}
+	body := imgCreateReq{
+		Model:          normalizeImageModel(req.ModelCode),
+		Prompt:         req.Prompt,
+		N:              count,
+		Size:           strParam(req.Params, "size", ""),
+		Quality:        strParam(req.Params, "quality", ""),
+		ResponseFormat: strParam(req.Params, "response_format", "url"),
+	}
+	if edit {
+		body.Image = imageMediaRef(refs[0])
+	}
+	payload, _ := json.Marshal(body)
+
+	logUpstream(ctx, req, provider.UpstreamLogEntry{
+		Provider: "grok",
+		Stage:    "images.start",
+		Method:   http.MethodPost,
+		URL:      url,
+		Meta: map[string]any{
+			"model":     body.Model,
+			"count":     count,
+			"edit":      edit,
+			"ref_count": len(refs),
+		},
+	})
+	start := time.Now()
+	raw, status, err := p.doRaw(ctx, http.MethodPost, url, payload, req.Credential)
+	if err != nil {
+		logUpstream(ctx, req, provider.UpstreamLogEntry{Provider: "grok", Stage: "images.request", Method: http.MethodPost, URL: url, Error: err.Error()})
+		return nil, err
+	}
+	if status >= 400 {
+		logUpstream(ctx, req, provider.UpstreamLogEntry{Provider: "grok", Stage: "images.error", Method: http.MethodPost, URL: url, StatusCode: status, ResponseExcerpt: snippet(raw, 240)})
+		return nil, fmt.Errorf("grok image %d: %s", status, snippet(raw, 240))
+	}
+	var out imgResp
+	if err := json.Unmarshal(raw, &out); err != nil {
+		logUpstream(ctx, req, provider.UpstreamLogEntry{Provider: "grok", Stage: "images.decode", Method: http.MethodPost, URL: url, StatusCode: status, ResponseExcerpt: snippet(raw, 240), Error: err.Error()})
+		return nil, fmt.Errorf("grok image decode: %w (raw=%s)", err, snippet(raw, 240))
+	}
+	if out.Error != nil && out.Error.Message != "" {
+		logUpstream(ctx, req, provider.UpstreamLogEntry{Provider: "grok", Stage: "images.error", Method: http.MethodPost, URL: url, StatusCode: status, ResponseExcerpt: snippet(raw, 240), Error: out.Error.Message})
+		return nil, fmt.Errorf("grok image: %s", out.Error.Message)
+	}
+	assets := make([]provider.Asset, 0, len(out.Data))
+	for _, item := range out.Data {
+		if strings.TrimSpace(item.URL) != "" {
+			assets = append(assets, provider.Asset{URL: item.URL, Mime: defaultImageMime(item.MimeType)})
+			continue
+		}
+		if strings.TrimSpace(item.B64JSON) != "" {
+			mimeType := defaultImageMime(item.MimeType)
+			assets = append(assets, provider.Asset{URL: "data:" + mimeType + ";base64," + item.B64JSON, Mime: mimeType})
+		}
+	}
+	if len(assets) == 0 {
+		logUpstream(ctx, req, provider.UpstreamLogEntry{Provider: "grok", Stage: "images.empty", Method: http.MethodPost, URL: url, StatusCode: status, ResponseExcerpt: snippet(raw, 240)})
+		return nil, fmt.Errorf("grok image returned 0 image")
+	}
+	logUpstream(ctx, req, provider.UpstreamLogEntry{
+		Provider:   "grok",
+		Stage:      "images.success",
+		Method:     http.MethodPost,
+		URL:        url,
+		StatusCode: status,
+		DurationMs: time.Since(start).Milliseconds(),
+		Meta:       map[string]any{"assets": len(assets)},
+	})
+	return &provider.Result{TaskID: req.TaskID, Assets: assets, Latency: time.Since(start)}, nil
+}
