+
+func apiBaseURL(base string) string {
+	base = strings.TrimRight(strings.TrimSpace(base), "/")
+	if base == "" {
+		return "https://api.x.ai"
+	}
+	if strings.HasSuffix(base, "/v1") {
+		return strings.TrimSuffix(base, "/v1")
+	}
+	return base
+}
+
+func isXAIAPIBase(base string) bool {
+	lower := strings.ToLower(strings.TrimSpace(base))
+	return strings.Contains(lower, "api.x.ai")
+}
+
+func wantsXAIVideoRoute(req *provider.Request, base string) bool {
+	if isXAIAPIBase(base) {
+		return true
+	}
+	if req == nil {
+		return false
+	}
+	route := strings.ToLower(strings.TrimSpace(strParam(req.Params, "route", strParam(req.Params, "provider_route", ""))))
+	switch route {
+	case "xai", "x-ai", "xai_api", "grok_api", "official":
+		return true
+	default:
+		return false
+	}
+}
+
+func shouldUseGrokWebRoute(base string) bool {
+	base = strings.ToLower(strings.TrimSpace(base))
+	return base == "" || strings.Contains(base, "grok.com")
+}
+
+func compactRefs(refs []string) []string {
+	out := make([]string, 0, len(refs))
+	for _, ref := range refs {
+		ref = strings.TrimSpace(ref)
+		if ref != "" {
+			out = append(out, ref)
+		}
+	}
+	return out
+}
+
+func imageMediaRef(ref string) *mediaRef {
+	ref = strings.TrimSpace(ref)
+	if ref == "" {
+		return nil
+	}
+	if strings.HasPrefix(ref, "file-") {
+		return &mediaRef{FileID: ref}
+	}
+	return &mediaRef{URL: ref, Type: "image_url"}
+}
+
+func normalizeImageModel(modelCode string) string {
+	modelCode = strings.TrimSpace(modelCode)
+	if modelCode == "" || strings.EqualFold(modelCode, "grok-image") {
+		return "grok-imagine-image"
+	}
+	return modelCode
+}
+
+func qualityToResolution(quality string) string {
+	switch strings.ToLower(strings.TrimSpace(quality)) {
+	case "low", "standard", "sd", "720p":
+		return "720p"
+	default:
+		return "1080p"
+	}
+}
+
+func defaultImageMime(mimeType string) string {
+	mimeType = strings.TrimSpace(mimeType)
+	if mimeType == "" {
+		return "image/png"
+	}
+	return mimeType
+}
+
+func firstNonEmptyString(values ...string) string {
+	for _, value := range values {
+		if strings.TrimSpace(value) != "" {
+			return strings.TrimSpace(value)
+		}
+	}
+	return ""
+}
