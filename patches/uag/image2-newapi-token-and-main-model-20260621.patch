new file mode 100644
--- /dev/null
+++ b/backend/internal/provider/gpt/image2_model_test.go
@@
+package gpt
+
+import "testing"
+
+func TestMainModelForImage2UsesImageModel(t *testing.T) {
+	if got := mainModelForImage2("gpt-image-2"); got != "gpt-image-2" {
+		t.Fatalf("mainModelForImage2() = %q, want gpt-image-2", got)
+	}
+	if got := mainModelForImage2("vendor/gpt-image-2"); got != "vendor/gpt-image-2" {
+		t.Fatalf("mainModelForImage2(vendor) = %q, want vendor/gpt-image-2", got)
+	}
+}
