+  try {
+    const parsed = JSON.parse(value)
+    if (typeof parsed !== 'object' || Array.isArray(parsed)) {
+      return false
+    }
+    for (const [, val] of Object.entries(parsed)) {
+      if (typeof val !== 'number') return false
+      if (val < 0 || val > 2147483647) return false
+    }
+    return true
+  } catch {
+    return false
+  }
+}
