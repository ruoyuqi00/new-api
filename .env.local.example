# Local preview only. Copy to .env.local and replace these values before use.
# These values are intentionally unrelated to any production deployment.

LOCAL_APP_IMAGE=newapi-local:production-brand-preview
LOCAL_MYSQL_DATABASE=newapi_local_preview
LOCAL_MYSQL_USER=newapi_local_user
LOCAL_MYSQL_PASSWORD=local-preview-mysql-password-change-before-use
LOCAL_MYSQL_ROOT_PASSWORD=local-preview-mysql-root-password-change-before-use
LOCAL_REDIS_PASSWORD=local-preview-redis-password-change-before-use
LOCAL_SESSION_SECRET=local-preview-session-secret-change-before-use-32-bytes
LOCAL_TZ=Asia/Shanghai
